---
import '@/styles/global.css';
import { SITE } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative path to the social card image. */
  ogImage?: string;
  /** 'website' for pages, 'article' for blog posts. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Set on the dynamic-service landing pages we do not want duplicated. */
  noindex?: boolean;
  /** Extra JSON-LD blocks, already stringified objects. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${SITE.tagline}`;

/*
  `build.format: 'file'` emits /blog/post.html, so Astro.url.pathname carries a
  .html suffix at build time while the sitemap emits the extensionless URL.
  Canonicals must match the sitemap exactly or the two disagree about which URL
  is authoritative, so normalise to the clean form here.
*/
const cleanPath =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImageAbs = new URL(ogImage, SITE.url).href;

// Person schema ships on every page: it is what ties the site to a named
// author for entity search, which is the point of the SEO effort.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  jobTitle: 'Spectrum auction analyst and software engineer',
  sameAs: ['https://github.com/avas15'],
};
---

<!doctype html>
<html lang={SITE.lang} data-theme="dark" class="no-motion">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#010a14" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={SITE.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script is:inline set:html={JSON.stringify(personSchema)} type="application/ld+json" />
    {schema.map((s) => <script is:inline set:html={JSON.stringify(s)} type="application/ld+json" />)}

    {/*
      Runs before first paint. Two jobs: restore the saved theme without a
      flash, and decide whether motion is allowed. `no-motion` ships in the
      HTML so content is visible with JS disabled or still loading; this
      removes it only when we are actually going to animate.
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('avzi-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) document.documentElement.classList.remove('no-motion');
      })();
    </script>
  </head>

  <body class="min-h-screen bg-bg text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:font-medium focus:text-on-brand"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '@/scripts/motion.ts';
    </script>
  </body>
</html>
