---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => import.meta.env.DEV || !p.data.draft)
    .map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-development': 'In development',
  prototype: 'Prototype',
  archived: 'Archived',
  'case-study': 'Case study',
};

// SoftwareApplication markup gives games and tools a shot at a rich result.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': d.kind === 'game' ? 'VideoGame' : 'SoftwareApplication',
  name: d.title,
  description: d.summary,
  applicationCategory: d.kind === 'game' ? 'Game' : 'WebApplication',
  author: { '@type': 'Person', name: SITE.author },
  url: new URL(`/projects/${project.id}`, SITE.url).href,
};
---

<BaseLayout
  title={d.title}
  description={d.description ?? d.summary}
  ogImage={d.cover?.src}
  schema={[appSchema]}
>
  <article class="mx-auto max-w-7xl px-5 pt-32 sm:px-8 sm:pt-40">
    <a
      href="/projects"
      class="text-[13px] text-ink-3 transition-colors duration-150 hover:text-brand"
    >
      &lt;&lt; cd ../work
    </a>

    <header class="mt-6 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2.5 text-[11px] font-500 uppercase tracking-wider">
        <span class="text-brand">{d.kind}</span>
        <span class="text-ink-3">/</span>
        <span class="text-ink-3">{statusLabel[d.status]}</span>
        <span class="text-ink-3">/</span>
        <span class="text-ink-3 tnum">{d.year}</span>
      </div>

      <h1 class="glow mt-4 text-3xl font-800 tracking-tight text-brand sm:text-4xl">{d.title}</h1>
      <p class="mt-4 leading-relaxed text-ink-2">{d.summary}</p>

      {
        d.links.length > 0 && (
          <div class="mt-7 flex flex-wrap items-center gap-2">
            {d.links.map((l) => (
              <a
                href={l.href}
                class:list={[
                  'border px-4 py-2 text-[13px] transition-colors duration-150',
                  l.primary
                    ? 'border-brand bg-brand font-700 text-on-brand hover:bg-transparent hover:text-brand'
                    : 'border-line-strong text-ink-2 hover:border-brand hover:text-brand',
                ]}
              >
                {l.gated && '[lock] '}[ {l.label.toLowerCase()} ]
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      d.cover && (
        <div class="mt-12 overflow-hidden rounded-xl border border-line" data-reveal>
          <Image
            src={d.cover}
            alt={d.coverAlt ?? ''}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1280px) 1200px, 100vw"
            class="w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="prose-avzi" data-reveal>
        <Content />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start" data-reveal data-reveal-delay="80">
        <div class="term term-corners">
          <div class="term-bar">meta</div>
          <div class="p-5">
            <h2 class="text-[11px] uppercase tracking-[0.2em] text-ink-3">// stack</h2>
            <ul class="mt-3 flex flex-wrap gap-1">
              {d.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>

            {
              d.genres.length > 0 && (
                <>
                  <h2 class="mt-6 text-[11px] uppercase tracking-[0.2em] text-ink-3">// genre</h2>
                  <ul class="mt-3 flex flex-wrap gap-1">
                    {d.genres.map((g) => (
                      <li class="tag">{g}</li>
                    ))}
                  </ul>
                </>
              )
            }
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
