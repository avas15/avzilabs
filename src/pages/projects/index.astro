---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const kinds = [...new Set(projects.map((p) => p.data.kind))];
---

<BaseLayout
  title="Work"
  description="Spectrum auction platforms, multiplayer games, data tools and prototypes built by Avas Saeed."
>
  <section class="mx-auto max-w-7xl px-5 pt-32 sm:px-8 sm:pt-40">
    <h1 class="text-4xl font-800 tracking-tight text-ink sm:text-5xl" data-reveal>Work</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
      Auction engines and operator consoles from the day job, games from the evenings, and tools
      built because the alternative was three pop-ups and a rate limit.
    </p>

    <ul class="mt-8 flex flex-wrap gap-2" data-reveal data-reveal-delay="120">
      {
        kinds.map((k) => (
          <li class="rounded border border-line px-2.5 py-1 text-[11px] font-500 uppercase tracking-wider text-ink-3">
            {k}
          </li>
        ))
      }
    </ul>

    <div data-reveal-group class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>
