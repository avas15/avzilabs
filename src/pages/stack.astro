---
import BaseLayout from '@/layouts/BaseLayout.astro';

const description =
  'The software I actually use: languages and data tooling, AI and agentic harnesses, creative and 3D software, infrastructure, and the security practices that go with running it.';

/*
  Grouped by what the tool is for rather than by how impressive it sounds.
  `note` is the honest bit: what it is genuinely used for here, not a claim of
  mastery. A skills list without that is just a wordcloud.
*/
const groups = [
  {
    id: 'build',
    title: 'languages and data',
    items: [
      { name: 'Python', note: 'scraping, ETL, valuation models, Monte Carlo, geospatial' },
      { name: 'TypeScript', note: 'auction platform, this site, the game servers' },
      { name: 'SQL', note: 'warehouse modelling, panel schemas, query tuning' },
      { name: 'C#', note: 'Unity gameplay, netcode, editor tooling' },
      { name: 'PHP', note: 'the earlier generation of auction platforms' },
      { name: 'R', note: 'regression and econometric work' },
      { name: 'VBA', note: 'bid-tracking toolkits people could actually run' },
    ],
  },
  {
    id: 'ai',
    title: 'AI and agentic tooling',
    items: [
      { name: 'Claude Code', note: 'primary harness. Custom MCP servers, skills, hooks' },
      { name: 'OpenCode', note: 'second harness, run against alternative models' },
      { name: 'llama.cpp', note: 'local inference for anything commercially sensitive' },
      { name: 'Qwen', note: 'general local model for coding and retrieval work' },
      { name: 'Gemma', note: 'smaller local model where speed matters more than depth' },
      { name: 'MCP', note: 'servers written for Unity, Photoshop and FL Studio' },
      { name: 'RAG and embeddings', note: 'structure-aware chunking, cited retrieval, OCR front end' },
    ],
  },
  {
    id: 'creative',
    title: 'creative and 3D',
    items: [
      { name: 'Unity', note: 'four game projects, plus a fair amount of editor tooling' },
      { name: 'Blender', note: 'modelling, and headless batch rendering for asset previews' },
      { name: 'Photoshop', note: 'texture and UI work, scripted through UXP' },
      { name: 'Illustrator', note: 'vector UI, icons, print-ready artwork' },
      { name: 'FL Studio', note: 'music and sound design, partly automated over MCP' },
      { name: 'EZCAD', note: 'laser marking and engraving control' },
    ],
  },
  {
    id: 'infra',
    title: 'infrastructure and shell',
    items: [
      { name: 'Linux / Ubuntu', note: 'where everything server-side actually lives' },
      { name: 'Amazon EC2', note: 'ran the previous auction and data platform in production' },
      { name: 'Cloudflare', note: 'Pages, Workers, Durable Objects, DNS, Zero Trust' },
      { name: 'Git and Git Bash', note: 'day-to-day on Windows without pretending it is Linux' },
      { name: 'Bash and PowerShell', note: 'automation, deploys, and the pre-agentic workflow' },
      { name: 'nginx and systemd', note: 'vhosts, units, and keeping services up' },
      { name: 'SQLite and Postgres', note: 'from single-file demos to production schemas' },
    ],
  },
];

const security = [
  {
    title: 'Reduce the attack surface before hardening it',
    body: 'This site runs with no inbound ports at all. The dynamic services reach the internet through an outbound tunnel and administration goes over a private mesh, so there is nothing exposed to scan. A port that does not exist needs no patching.',
  },
  {
    title: 'Secrets never enter the repository',
    body: 'The public repo runs gitleaks on every push. Real credentials live in environment variables and a password manager, and the generated CV is deliberately ignored by git because it carries a personal phone number. The gate matters because older projects on the same machine do contain real .env files.',
  },
  {
    title: 'Least privilege on API tokens',
    body: 'Scoped, single-zone API tokens rather than global keys, and expanded only when a specific operation actually needs it. Where a task could be done through a narrower account-level endpoint instead of a broader zone permission, it was.',
  },
  {
    title: 'The server is not the trust boundary',
    body: 'In the multiplayer game the server owns the clock, the letters and every scoring decision, and never sends other players their opponents’ answers. Client-side validation is a convenience; anything that decides an outcome is computed where the player cannot reach it.',
  },
  {
    title: 'Transport and origin hygiene',
    body: 'TLS 1.2 floor with 1.3 enabled, HTTPS enforced, strict origin validation, and CORS that echoes only the allowed origin rather than reflecting whatever asks. Databases belong outside the web root, which is worth saying because that is a mistake I have found in my own older deployments.',
  },
  {
    title: 'Sanitisation as a design decision',
    body: 'Published demos are rebuilt in an invented domain rather than redacted from client code. Find-and-replace leaves comments, identifiers and business logic intact, and you cannot un-publish it. Rebuilding is less work than auditing a redaction you can never fully trust.',
  },
];
---

<BaseLayout title="Stack" description={description}>
  <section class="mx-auto max-w-5xl px-5 pt-32 sm:px-8 sm:pt-40">
    <h1 class="glow text-3xl font-800 tracking-tight text-brand sm:text-4xl" data-reveal>
      ./stack
    </h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
      What I actually use, and what I use it for. Listed with the honest caveat rather than the
      flattering one: some of these I live in daily, others I reach for a few times a year.
    </p>

    <div data-reveal-group class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        groups.map((g) => (
          <section data-reveal-item class="term term-corners" aria-labelledby={`h-${g.id}`}>
            <div class="term-bar">
              <span class="text-brand">$</span>
              <span id={`h-${g.id}`}>{g.title}</span>
              <span class="ml-auto tnum">{g.items.length}</span>
            </div>
            <ul class="p-4">
              {g.items.map((i) => (
                <li class="flex flex-col gap-0.5 border-b border-line py-2 last:border-0 sm:flex-row sm:items-baseline sm:gap-3">
                  <span class="w-40 shrink-0 text-[13px] text-ink">{i.name}</span>
                  <span class="text-[12px] leading-relaxed text-ink-3">{i.note}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <h2 class="mt-16 text-xl font-700 tracking-tight text-brand sm:text-2xl" data-reveal>
      ./security
    </h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-2" data-reveal>
      Not a certification list. These are the decisions actually taken across the projects on
      this site, including the ones that came from finding my own mistakes.
    </p>

    <ol data-reveal-group class="mt-8 space-y-4">
      {
        security.map((s, i) => (
          <li data-reveal-item class="term term-corners">
            <div class="term-bar">
              <span class="text-brand tnum">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.title}</span>
            </div>
            <p class="p-4 text-[13px] leading-relaxed text-ink-2">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
