---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
  Landing page only. Nothing here links to a running service: the game servers
  do not exist yet, and no service origin is referenced anywhere in this build.
*/
const games = [
  {
    title: 'BidSim',
    blurb:
      'A live multi-team spectrum auction. Teams hold home bands, marginal valuations and deploy costs, and bid in real time. Built for classroom sessions, and genuinely tense.',
    players: '2 to 12 players',
  },
  {
    title: 'Drawing game',
    blurb:
      'Round-based drawing and guessing with room codes. One person draws, everyone else races to guess. Skribbl in spirit, without the ads.',
    players: '3 to 10 players',
  },
  {
    title: 'Card party',
    blurb:
      'A fill-in-the-blank party card game with custom decks. Built on the Cards Against Humanity licence, which permits non-commercial derivatives, under its own name.',
    players: '4 to 10 players',
  },
];
---

<BaseLayout
  title="Play"
  description="Multiplayer party games and live auction simulations you can play in the browser with friends. No ads, no accounts for guests."
>
  <section class="mx-auto max-w-4xl px-5 pt-32 sm:px-8 sm:pt-40">
    <h1 class="text-4xl font-800 tracking-tight text-ink sm:text-5xl" data-reveal>Play</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
      Browser games you can start with a room code and a link. Nothing to install, no account
      needed to join, and no advertising anywhere near them.
    </p>

    <ul data-reveal-group class="mt-14 space-y-4">
      {
        games.map((g) => (
          <li
            data-reveal-item
            class="rounded-lg border border-line bg-surface p-6 transition-colors duration-200 hover:border-line-strong"
          >
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-xl font-600 tracking-tight text-ink">{g.title}</h2>
              <span class="text-[11px] font-500 uppercase tracking-wider text-warn">
                Under development
              </span>
              <span class="ml-auto text-xs text-ink-3 tnum">{g.players}</span>
            </div>

            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-2">{g.blurb}</p>

            <p class="mt-5 text-sm text-ink-3">Not open yet.</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
