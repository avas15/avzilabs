---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
  Landing page only. Nothing here links to a running service: the game servers
  do not exist yet, and no service origin is referenced anywhere in this build.
*/
const games = [
  {
    title: 'Cat Dog Fish',
    blurb:
      'Spin for a letter, fill every category before the clock runs out. Unique answers beat ones somebody else also thought of. Rejected answers can be protested, and the table votes.',
    players: '2 to 10 players',
    href: '/play/cat-dog-fish',
  },
  {
    title: 'Drawing game',
    blurb:
      'Round-based drawing and guessing with room codes. One person draws, everyone else races to guess. Skribbl in spirit, without the ads.',
    players: '3 to 10 players',
    href: null,
  },
  {
    title: 'Card party',
    blurb:
      'A fill-in-the-blank party card game with custom decks. Built on the Cards Against Humanity licence, which permits non-commercial derivatives, under its own name.',
    players: '4 to 10 players',
    href: null,
  },
  {
    title: 'BidSim',
    blurb:
      'A live multi-team spectrum auction. Teams hold home bands, marginal valuations and deploy costs, and bid in real time. Built for classroom sessions, and genuinely tense.',
    players: '2 to 12 players',
    href: null,
  },
];
---

<BaseLayout
  title="Play"
  description="Multiplayer party games and live auction simulations you can play in the browser with friends. No ads, no accounts for guests."
>
  <section class="mx-auto max-w-4xl px-5 pt-32 sm:px-8 sm:pt-40">
    <h1 class="glow text-3xl font-800 tracking-tight text-brand sm:text-4xl" data-reveal>
      ./play
    </h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
      Browser games you can start with a room code and a link. Nothing to install, no account
      needed to join, and no advertising anywhere near them.
    </p>

    <ul data-reveal-group class="mt-14 space-y-4">
      {
        games.map((g) => (
          <li data-reveal-item class="term term-corners">
            <div class="term-bar">
              <span class="text-brand">[##]</span>
              <span>{g.title.toLowerCase().replace(/\s+/g, '-')}</span>
              <span class:list={['ml-auto', g.href ? 'text-ok' : 'text-warn']}>
                {g.href ? 'LIVE' : 'WIP'}
              </span>
            </div>
            <div class="p-5">
              <div class="flex flex-wrap items-baseline gap-3">
                <h2 class="text-lg font-700 tracking-tight text-ink">{g.title}</h2>
                <span class="ml-auto text-[11px] text-ink-3 tnum">{g.players}</span>
              </div>

              <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-ink-2">{g.blurb}</p>

              {
                g.href ? (
                  <a
                    href={g.href}
                    class="mt-5 inline-block border border-brand bg-brand px-4 py-2 text-[13px] font-700 text-on-brand transition-colors duration-150 hover:bg-transparent hover:text-brand"
                  >
                    [ play now ]
                  </a>
                ) : (
                  <p class="mt-5 text-[13px] text-ink-3">
                    <span class="text-warn">&gt;</span> not open yet
                  </p>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
