---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import FeaturedCard from '@/components/FeaturedCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Terminal from '@/components/Terminal.astro';
import { SITE } from '@/config';

const isPublished = <T extends { data: { draft: boolean } }>(e: T) =>
  import.meta.env.DEV || !e.data.draft;

const allProjects = (await getCollection('projects')).filter(isPublished);
const posts = (await getCollection('blog'))
  .filter(isPublished)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = allProjects.find((p) => p.data.featured);
const grid = allProjects
  .filter((p) => p.id !== featured?.id)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year)
  .slice(0, 6);

const stats = [
  { label: 'Projects shipped', value: String(allProjects.length) },
  { label: 'Live demos', value: String(allProjects.filter((p) => p.data.status === 'live').length) },
  { label: 'Posts written', value: String(posts.length) },
  { label: 'Years in spectrum', value: '5' },
];

// Feeds the interactive terminal, so `projects` and `blog` list the real thing.
const termProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    title: p.data.title,
    id: p.id,
    kind: p.data.kind,
    status: p.data.status,
    year: p.data.year,
  }));
const termPosts = posts.map((p) => ({ title: p.data.title, id: p.id }));

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout schema={[websiteSchema]}>
  <Hero stats={stats} />

  {featured && <FeaturedCard project={featured} />}

  {/* Selected work */}
  {
    grid.length > 0 && (
      <section aria-labelledby="work-heading" class="mx-auto max-w-7xl px-5 pt-24 sm:px-8">
        <div class="mb-8 flex items-end justify-between gap-6" data-reveal>
          <div>
            <h2
              id="work-heading"
              data-typewriter
              class="text-xl font-700 tracking-tight text-brand sm:text-2xl"
            >
              ./selected-work
            </h2>
            <p class="mt-2 max-w-xl text-[14px] text-ink-2">
              Auction platforms, games, and the occasional tool built because the alternative
              wanted my email address.
            </p>
          </div>
          <a
            href="/projects"
            class="hidden shrink-0 text-[13px] text-brand transition-colors duration-150 hover:text-brand-hover sm:inline-flex"
          >
            all work &gt;&gt;
          </a>
        </div>

        <div
          data-reveal-group
          class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
        >
          {grid.map((p, i) => (
            <ProjectCard project={p} eager={i < 3} />
          ))}
        </div>
      </section>
    )
  }

  {/* Latest writing */}
  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading" class="mx-auto max-w-7xl px-5 pt-24 sm:px-8">
        <div class="mb-8 flex items-end justify-between gap-6" data-reveal>
          <h2
            id="writing-heading"
            data-typewriter
            class="text-xl font-700 tracking-tight text-brand sm:text-2xl"
          >
            ./writing
          </h2>
          <a
            href="/blog"
            class="shrink-0 text-[13px] text-brand transition-colors duration-150 hover:text-brand-hover"
          >
            all posts &gt;&gt;
          </a>
        </div>

        <ul data-reveal-group class="divide-y divide-line border-y border-line">
          {posts.slice(0, 4).map((post) => (
            <li data-reveal-item>
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-2 py-5 transition-colors duration-150 sm:flex-row sm:items-baseline sm:gap-8"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="shrink-0 text-sm text-ink-3 tnum sm:w-28"
                >
                  {post.data.pubDate.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: '2-digit',
                  })}
                </time>
                <div class="min-w-0 flex-1">
                  <h3 class="text-[15px] font-700 text-ink transition-colors duration-150 group-hover:text-brand">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 text-[13px] leading-relaxed text-ink-2">{post.data.description}</p>
                </div>
                <span
                  aria-hidden="true"
                  class="hidden shrink-0 self-center text-[11px] text-ink-3 transition-colors duration-150 group-hover:text-brand sm:block"
                >
                  &gt;&gt;
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Terminal projects={termProjects} posts={termPosts} />

  {/* Closing call to action */}
  <section class="mx-auto max-w-7xl px-5 pt-24 sm:px-8">
    <div class="term term-corners relative p-8 sm:p-12" data-reveal>
      <h2 class="max-w-lg text-xl font-700 tracking-tight text-ink sm:text-2xl">
        Building something in auctions, games, or data?
      </h2>
      <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-ink-2">
        I am usually up for a conversation about auction design, multiplayer netcode, or why
        your spectrum benchmark is off by a factor of population.
      </p>
      <a
        href="mailto:avas.saeed@gmail.com"
        class="mt-7 inline-block border border-brand bg-brand px-5 py-2.5 text-[13px] font-700 text-on-brand transition-colors duration-150 hover:bg-transparent hover:text-brand"
      >
        [ get in touch ]
      </a>
    </div>
  </section>
</BaseLayout>
