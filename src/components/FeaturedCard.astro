---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;

const statusLabel: Record<string, string> = {
  live: 'AVAILABLE NOW',
  'in-development': 'IN DEVELOPMENT',
  prototype: 'PROTOTYPE',
  archived: 'ARCHIVED',
  'case-study': 'CASE STUDY',
};

const primary = d.links.find((l) => l.primary);
const secondary = d.links.filter((l) => !l.primary);
---

<section aria-labelledby="featured-heading" class="mx-auto max-w-7xl px-5 sm:px-8">
  <div class="mb-5 flex items-center gap-3" data-reveal>
    <h2 id="featured-heading" class="text-xs uppercase tracking-[0.2em] text-ink-3">
      [ featured release ]
    </h2>
    <div class="rule-ascii flex-1 text-xs">
      ────────────────────────────────────────────────────────────────────────────────
    </div>
  </div>

  <article class="term term-corners group" data-reveal data-reveal-delay="80">
    <div class="term-bar">
      <span class="text-brand">▶</span>
      <span>/featured/{project.id}</span>
      <span class="ml-auto text-warn">{statusLabel[d.status] ?? d.status}</span>
    </div>

    <div class="grid lg:grid-cols-[1.55fr_1fr]">
      <div
        class="relative aspect-16/9 overflow-hidden border-b border-line bg-bg-subtle lg:aspect-auto lg:min-h-[24rem] lg:border-b-0 lg:border-r"
      >
        {
          d.heroVideo ? (
            <video
              class="absolute inset-0 h-full w-full object-cover opacity-85"
              autoplay
              muted
              loop
              playsinline
              preload="none"
              poster={d.heroPoster?.src}
              aria-label={`${d.title} footage`}
            >
              <source src={d.heroVideo} type="video/mp4" />
            </video>
          ) : d.cover ? (
            <Image
              src={d.cover}
              alt={d.coverAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 60vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover opacity-85 transition-all duration-500 group-hover:scale-[1.02] group-hover:opacity-100"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div
              aria-hidden="true"
              class="ascii absolute inset-0 flex items-center justify-center overflow-hidden p-4 text-[8px] leading-[1.15] text-mtx-900 sm:text-[10px]"
            >
              {`  ┌──────────────────────────────────┐
  │ ▓▓▒▒░░  NO PREVIEW SIGNAL  ░░▒▒▓ │
  ├──────────────────────────────────┤
  │ 01001110 01001111 01010011 01001 │
  │ 11010010 11010010 11010010 11010 │
  │ ░░▒▒▓▓██  AWAITING FEED  ██▓▓▒▒░ │
  │ 10110100 10110100 10110100 10110 │
  │ 01011010 01011010 01011010 01011 │
  └──────────────────────────────────┘`}
            </div>
          )
        }
      </div>

      <div class="flex flex-col p-6 sm:p-7">
        <h3 class="glow text-2xl font-700 tracking-tight text-brand sm:text-3xl">
          {d.title}
        </h3>

        <p class="mt-3 text-[14px] leading-relaxed text-ink-2">
          {d.summary}
        </p>

        {
          d.genres.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1">
              {d.genres.map((g) => (
                <li class="tag">{g}</li>
              ))}
            </ul>
          )
        }

        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-5 text-[13px]">
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-ink-3">year</dt>
            <dd class="mt-0.5 text-ink tnum">{d.year}</dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-wider text-ink-3">built with</dt>
            <dd class="mt-0.5 text-ink">{d.stack.slice(0, 2).join(', ')}</dd>
          </div>
        </dl>

        <div class="mt-auto flex flex-wrap items-center gap-2 pt-7">
          {
            primary && (
              <a
                href={primary.href}
                class="border border-brand bg-brand px-4 py-2 text-[13px] font-700 text-on-brand transition-colors duration-150 hover:bg-transparent hover:text-brand"
              >
                {primary.gated && '[lock] '}[ {primary.label.toLowerCase()} ]
              </a>
            )
          }

          {
            secondary.map((l) => (
              <a
                href={l.href}
                class="border border-line-strong px-4 py-2 text-[13px] text-ink-2 transition-colors duration-150 hover:border-brand hover:text-brand"
              >
                {l.label.toLowerCase()}
              </a>
            ))
          }

          <a
            href={`/projects/${project.id}`}
            class="px-1 text-[13px] text-ink-3 transition-colors duration-150 hover:text-brand"
          >
            details &gt;&gt;
          </a>
        </div>
      </div>
    </div>
  </article>
</section>
