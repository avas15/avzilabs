---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;

const statusLabel: Record<string, string> = {
  live: 'Available now',
  'in-development': 'In development',
  prototype: 'Prototype',
  archived: 'Archived',
  'case-study': 'Case study',
};

const primary = d.links.find((l) => l.primary);
const secondary = d.links.filter((l) => !l.primary);
---

{/*
  Storefront hero slot. One project carries `featured: true` and lands here.
  Layout mirrors a store page: media on the left, the buy panel on the right.
*/}
<section aria-labelledby="featured-heading" class="mx-auto max-w-7xl px-5 sm:px-8">
  <div class="mb-5 flex items-center gap-3" data-reveal>
    <Icon name="lucide:gamepad-2" class="h-4 w-4 text-brand" stroke-width={1.75} />
    <h2 id="featured-heading" class="text-xs font-600 uppercase tracking-wider text-ink-3">
      Featured release
    </h2>
    <div class="h-px flex-1 bg-line"></div>
  </div>

  <article
    class="group overflow-hidden rounded-xl border border-line bg-surface transition-colors duration-200 hover:border-line-strong"
    data-reveal
    data-reveal-delay="80"
  >
    <div class="grid lg:grid-cols-[1.55fr_1fr]">
      {/* Media */}
      <div class="relative aspect-16/9 overflow-hidden bg-bg-subtle lg:aspect-auto lg:min-h-[26rem]">
        {
          d.heroVideo ? (
            <video
              class="absolute inset-0 h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="none"
              poster={d.heroPoster?.src}
              aria-label={`${d.title} gameplay footage`}
            >
              <source src={d.heroVideo} type="video/mp4" />
            </video>
          ) : d.cover ? (
            <Image
              src={d.cover}
              alt={d.coverAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 60vw, 100vw"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="hero-gradient absolute inset-0" />
          )
        }

        <div class="absolute left-4 top-4 flex items-center gap-2">
          <span
            class="rounded-md bg-bg/85 px-2.5 py-1 text-[11px] font-600 uppercase tracking-wider text-brand"
          >
            {statusLabel[d.status] ?? d.status}
          </span>
        </div>
      </div>

      {/* Panel */}
      <div class="flex flex-col p-6 sm:p-8">
        <h3 class="text-2xl font-700 tracking-tight text-ink sm:text-3xl">
          {d.title}
        </h3>

        <p class="mt-3 text-[15px] leading-relaxed text-ink-2">
          {d.summary}
        </p>

        {
          d.genres.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {d.genres.map((g) => (
                <li class="rounded border border-line px-2 py-1 text-[11px] font-500 text-ink-3">
                  {g}
                </li>
              ))}
            </ul>
          )
        }

        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-5 text-sm">
          <div>
            <dt class="text-xs text-ink-3">Year</dt>
            <dd class="mt-0.5 font-500 text-ink tnum">{d.year}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-3">Built with</dt>
            <dd class="mt-0.5 font-500 text-ink">{d.stack.slice(0, 2).join(', ')}</dd>
          </div>
        </dl>

        <div class="mt-auto flex flex-wrap items-center gap-2.5 pt-7">
          {
            primary && (
              <a
                href={primary.href}
                class="inline-flex items-center gap-2 rounded-md bg-brand px-5 py-2.5 text-sm font-600 text-on-brand transition-colors duration-150 hover:bg-brand-hover"
              >
                {primary.gated && <Icon name="lucide:lock" class="h-4 w-4" stroke-width={1.75} />}
                {primary.label}
                <Icon name="lucide:arrow-right" class="h-4 w-4" stroke-width={1.75} />
              </a>
            )
          }

          {
            secondary.map((l) => (
              <a
                href={l.href}
                class="inline-flex items-center gap-2 rounded-md border border-line-strong px-4 py-2.5 text-sm font-500 text-ink-2 transition-colors duration-150 hover:border-brand hover:text-ink"
              >
                {l.label}
                <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" stroke-width={1.75} />
              </a>
            ))
          }

          <a
            href={`/projects/${project.id}`}
            class="px-1 text-sm font-500 text-ink-3 underline-offset-4 transition-colors duration-150 hover:text-brand hover:underline"
          >
            Details
          </a>
        </div>
      </div>
    </div>
  </article>
</section>
