---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Cards above the fold should not lazy-load their cover. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const d = project.data;

const kindIcon: Record<string, string> = {
  game: 'lucide:gamepad-2',
  webapp: 'lucide:external-link',
  data: 'lucide:chart-no-axes-column',
  tool: 'lucide:wrench',
  platform: 'lucide:radio-tower',
};

const statusTone: Record<string, string> = {
  live: 'text-ok',
  'in-development': 'text-warn',
  prototype: 'text-info',
  archived: 'text-ink-3',
  'case-study': 'text-info',
};

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-development': 'In development',
  prototype: 'Prototype',
  archived: 'Archived',
  'case-study': 'Case study',
};
---

<article
  data-reveal-item
  class="group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-[border-color,transform] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] hover:-translate-y-0.5 hover:border-line-strong"
>
  <div class="relative aspect-16/10 overflow-hidden bg-bg-subtle">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="hero-gradient h-full w-full opacity-70" />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-2">
      <Icon
        name={kindIcon[d.kind] ?? 'lucide:file-text'}
        class="h-3.5 w-3.5 text-ink-3"
        stroke-width={1.5}
      />
      <span class="text-[11px] font-500 uppercase tracking-wider text-ink-3">{d.kind}</span>
      <span class="text-ink-3">/</span>
      <span class:list={['text-[11px] font-500', statusTone[d.status]]}>
        {statusLabel[d.status]}
      </span>
      <span class="ml-auto text-[11px] text-ink-3 tnum">{d.year}</span>
    </div>

    <h3 class="mt-3 text-lg font-600 tracking-tight text-ink">
      {/* Stretched link: the whole card is the hit target, no nested anchors. */}
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {d.title}
      </a>
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-ink-2">{d.summary}</p>

    {
      d.stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5 pt-1">
          {d.stack.slice(0, 4).map((s) => (
            <li class="rounded border border-line px-1.5 py-0.5 text-[11px] text-ink-3">{s}</li>
          ))}
        </ul>
      )
    }

    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-500 text-brand opacity-0 transition-opacity duration-150 group-hover:opacity-100"
      aria-hidden="true"
    >
      Read more
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" stroke-width={1.75} />
    </span>
  </div>
</article>
