---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const d = project.data;

// ASCII markers rather than icons, for the period look.
const kindMark: Record<string, string> = {
  game: '[##]',
  webapp: '[<>]',
  data: '[::]',
  tool: '[\\/]',
  platform: '[//]',
};

const statusTone: Record<string, string> = {
  live: 'text-ok',
  'in-development': 'text-warn',
  prototype: 'text-info',
  archived: 'text-ink-3',
  'case-study': 'text-info',
};

const statusLabel: Record<string, string> = {
  live: 'LIVE',
  'in-development': 'WIP',
  prototype: 'PROTO',
  archived: 'ARCHIVE',
  'case-study': 'STUDY',
};
---

<article
  data-reveal-item
  class="term term-corners group relative flex flex-col transition-[border-color,transform] duration-200 hover:-translate-y-0.5"
>
  <div class="term-bar">
    <span class="text-brand">{kindMark[d.kind] ?? '[--]'}</span>
    <span>{d.kind}</span>
    <span class:list={['ml-auto', statusTone[d.status]]}>{statusLabel[d.status]}</span>
  </div>

  <div class="relative aspect-16/10 overflow-hidden border-b border-line bg-bg-subtle">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover opacity-80 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04] group-hover:opacity-100"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div
          aria-hidden="true"
          class="ascii flex h-full w-full items-center justify-center text-[9px] leading-[1.1] text-mtx-900 transition-colors duration-300 group-hover:text-mtx-800"
        >
          {`010110100101101001011010\n110100101101001011010010\n101101001011010010110100\n010110100101101001011010\n110100101101001011010010`}
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base font-700 tracking-tight text-ink transition-colors group-hover:text-brand">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {d.title}
      </a>
    </h3>

    <p class="mt-2 text-[13px] leading-relaxed text-ink-2">{d.summary}</p>

    {
      d.stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1">
          {d.stack.slice(0, 4).map((s) => (
            <li class="tag">{s}</li>
          ))}
        </ul>
      )
    }

    <div class="mt-4 flex items-center justify-between border-t border-line pt-3">
      <span class="text-[11px] text-ink-3 tnum">{d.year}</span>
      <span
        class="text-[11px] text-brand opacity-0 transition-opacity duration-150 group-hover:opacity-100"
        aria-hidden="true"
      >
        open &gt;&gt;
      </span>
    </div>
  </div>
</article>
