---
import { NAV, SITE, SOCIAL } from '@/config';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
    <div class="rule-ascii mb-10 text-xs">
      ┌───────────────────────────────────────────────────────────────────────────────────────┐
    </div>

    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2">
          <span class="text-brand">▓</span>
          <span class="teletext text-base text-ink">AVZILABS<span class="text-brand">_</span></span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink-3">
          {SITE.tagline}
        </p>
      </div>

      <div class="flex gap-14">
        <div>
          <h2 class="text-[11px] uppercase tracking-[0.2em] text-ink-3">/site</h2>
          <ul class="mt-4 space-y-2">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
                  >
                    <span class="text-ink-3">&gt;</span> {item.label.toLowerCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-[11px] uppercase tracking-[0.2em] text-ink-3">/elsewhere</h2>
          <ul class="mt-4 space-y-2">
            <li>
              <a
                href={SOCIAL.github}
                rel="me noopener"
                class="text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <span class="text-ink-3">&gt;</span> github
              </a>
            </li>
            <li>
              <a
                href={`mailto:${SOCIAL.email}`}
                class="text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <span class="text-ink-3">&gt;</span> email
              </a>
            </li>
            <li>
              <a
                href="/rss.xml"
                class="text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <span class="text-ink-3">&gt;</span> rss
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="text-[11px] text-ink-3 tnum">
        <span class="text-brand">&gt;</span> {year} {SITE.author} — built with astro, served from the edge
      </p>
    </div>
  </div>
</footer>
