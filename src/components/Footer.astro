---
import { Icon } from 'astro-icon/components';
import { NAV, SITE, SOCIAL } from '@/config';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span class="hero-gradient grid h-8 w-8 place-items-center rounded-md">
            <span class="text-sm font-800 tracking-tight text-white">A</span>
          </span>
          <span class="text-[15px] font-600 tracking-tight text-ink">{SITE.name}</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink-3">
          {SITE.tagline}
        </p>
      </div>

      <div class="flex gap-14">
        <div>
          <h2 class="text-xs font-600 uppercase tracking-wider text-ink-3">Site</h2>
          <ul class="mt-4 space-y-2.5">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-600 uppercase tracking-wider text-ink-3">Elsewhere</h2>
          <ul class="mt-4 space-y-2.5">
            <li>
              <a
                href={SOCIAL.github}
                rel="me noopener"
                class="inline-flex items-center gap-2 text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <Icon name="lucide:github" class="h-4 w-4" stroke-width={1.5} />
                GitHub
              </a>
            </li>
            <li>
              <a
                href={`mailto:${SOCIAL.email}`}
                class="inline-flex items-center gap-2 text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <Icon name="lucide:mail" class="h-4 w-4" stroke-width={1.5} />
                Email
              </a>
            </li>
            <li>
              <a
                href="/rss.xml"
                class="inline-flex items-center gap-2 text-sm text-ink-2 transition-colors duration-150 hover:text-brand"
              >
                <Icon name="lucide:rss" class="h-4 w-4" stroke-width={1.5} />
                RSS
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="text-xs text-ink-3 tnum">
        {year} {SITE.author}. Built with Astro, served from the edge.
      </p>
    </div>
  </div>
</footer>
