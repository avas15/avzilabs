---
interface Props {
  stats: { label: string; value: string }[];
}

const { stats } = Astro.props;

// Written as data so the boot sequence stays declarative and easy to retime.
const BOOT = [
  { text: 'initialising avzilabs kernel', tag: 'OK' },
  { text: 'mounting /projects /blog /play /tools', tag: 'OK' },
  { text: 'establishing edge connection', tag: 'OK' },
  { text: 'decrypting operator profile', tag: 'OK' },
];
---

<section data-hero class="relative overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    {/*
      Teletext wordmark. The outer element carries the double-height scale so
      the reveal animation can transform the inner one without the two fighting.
      Reserved height below matches the scaled result and keeps CLS at zero.
    */}
    <div class="mb-9 h-[3.1rem] sm:h-[4.6rem] md:h-[5.8rem]">
      <div class="teletext-double">
        <h2
          data-hero-logo
          class="teletext glow text-[1.7rem] leading-none text-brand sm:text-[2.5rem] md:text-[3.2rem]"
        >
          AVZILABS
        </h2>
      </div>
    </div>

    <ol data-boot class="mb-9 space-y-0.5 text-xs sm:text-[13px]" aria-label="Boot sequence">
      {
        BOOT.map((b) => (
          <li data-boot-line class="flex items-center gap-2 text-ink-3">
            <span class="text-brand">[{b.tag}]</span>
            <span>{b.text}</span>
          </li>
        ))
      }
    </ol>

    <h1
      class="max-w-4xl text-[26px] font-700 leading-[1.25] tracking-tight sm:text-4xl lg:text-5xl"
    >
      <span data-hero-line class="block text-ink">I work out what spectrum</span>
      <span data-hero-line class="block text-ink">is worth, plan the bidding,</span>
      <span data-hero-line class="glow block text-brand">and build what runs it.</span>
    </h1>

    <div
      data-hero-rule
      aria-hidden="true"
      class="rule-ascii mt-8 max-w-3xl origin-left text-xs"
    >
      ════════════════════════════════════════════════════════════════════════════════════
    </div>

    <p data-hero-fade class="mt-7 max-w-2xl leading-relaxed text-ink-2">
      <span class="text-brand">$</span> whoami <br />
      Avzi. I value spectrum, set the bid strategy, and write the simulation, tracking and
      live-auction software that the strategy runs on. The rest of the time I make games, data
      tools, and things that should not have needed an ad-blocker to use.
    </p>

    <div data-hero-fade class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href="/projects"
        class="border border-brand bg-brand px-5 py-2.5 text-sm font-700 text-on-brand transition-colors duration-150 hover:bg-transparent hover:text-brand"
      >
        [ see the work ]
      </a>
      <a
        href="/play"
        class="border border-line-strong px-5 py-2.5 text-sm text-ink-2 transition-colors duration-150 hover:border-brand hover:text-brand"
      >
        [ play something ]
      </a>
    </div>

    {
      stats.length > 0 && (
        <dl
          data-hero-fade
          class="term mt-14 grid max-w-3xl grid-cols-2 border-line sm:grid-cols-4"
        >
          {stats.map((s) => (
            <div class="border-b border-r border-line p-4 last:border-r-0">
              <dd class="text-xl font-700 text-brand tnum">{s.value}</dd>
              <dt class="mt-0.5 text-[11px] uppercase tracking-wider text-ink-3">{s.label}</dt>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
