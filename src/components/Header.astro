---
import { NAV, SITE, UNDER_DEVELOPMENT } from '@/config';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-200 [&.is-stuck]:border-line [&.is-stuck]:bg-bg/95 [&.is-stuck]:backdrop-blur-[2px]"
>
  {
    UNDER_DEVELOPMENT && (
      <div class="border-b border-line bg-surface">
        <p class="mx-auto max-w-7xl px-5 py-1 text-center text-[11px] uppercase tracking-[0.2em] text-warn sm:px-8">
          [ under development ]
        </p>
      </div>
    )
  }

  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="group flex items-center gap-2" aria-label={`${SITE.name} home`}>
      <span class="text-brand">▓</span>
      <span class="text-sm font-700 tracking-tight text-ink group-hover:text-brand">
        avzilabs<span class="text-brand">_</span>
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-1.5 text-[13px] transition-colors duration-150',
              isActive(item.href)
                ? 'text-brand'
                : 'text-ink-2 hover:bg-brand hover:text-on-brand',
            ]}
          >
            {isActive(item.href) ? `[${item.label.toLowerCase()}]` : item.label.toLowerCase()}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        class="border border-line px-2 py-1 text-[11px] uppercase tracking-wider text-ink-3 transition-colors duration-150 hover:border-brand hover:text-brand"
        aria-label="Toggle colour theme"
      >
        <span data-theme-label>dark</span>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="border border-line px-2 py-1 text-[11px] uppercase tracking-wider text-ink-3 transition-colors duration-150 hover:border-brand hover:text-brand md:hidden"
      >
        menu
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-bg md:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-2" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'py-2.5 text-sm transition-colors duration-150',
              isActive(item.href) ? 'text-brand' : 'text-ink-2 hover:text-brand',
            ]}
          >
            <span class="text-brand">&gt;</span> {item.label.toLowerCase()}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const label = document.querySelector('[data-theme-label]');

  function syncLabel() {
    if (label) label.textContent = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }
  syncLabel();

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    syncLabel();
    try {
      localStorage.setItem('avzi-theme', next);
    } catch (e) {
      /* private mode */
    }
  });

  const menuBtn = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
