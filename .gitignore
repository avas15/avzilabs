# build output
dist/
.astro/
.output/

# dependencies
node_modules/
.pnpm-store/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# environment - never commit these, the repo is public
.env
.env.*
!.env.example

# secrets and keys
*.pem
*.key
*.p12
*.pfx
secrets/
*.tfvars

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# large media belongs on R2, not in git
public/media/**/*.mp4
public/media/**/*.webm
public/media/**/*.mov

# generated CV - carries a personal phone number, never commit
private/

# wrangler local build artifacts
.wrangler/
workers/**/.wrangler/

# slot-allocation demo: generated, rebuilt by build_demo_db.py / news_updater.py
demos/slot-allocation/data/demo.sqlite
demos/slot-allocation/etl/cache/

# Cat Dog Fish seed data: regenerate with workers/catdogfish/scripts/build-dictionaries.py
# Committed only once complete; a partial build must never ship.
workers/catdogfish/src/dictionaries.json
